  "metadata": {
    "name": "mozaik_cctp_forwarder",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "Forwards USDC from per-account Solana deposit addresses to MozaikPay accounts on Base through Circle CCTP V2",
    "repository": "https://github.com/sig-0/mozaikpay-solana"
  },
  "instructions": [
    {
      "name": "forward",
      "docs": [
        "Moves up to `amount` USDC from a token account that delegates to the forwarder of",
        "`account`, then burns the whole vault balance through CCTP V2 with `account` on Base as",
        "the mint recipient. Lowers `max_fee` to 20 bps of the burned amount when it is above that.",
        "Anyone can call it."
      ],
