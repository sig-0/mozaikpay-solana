# RPC endpoints. Leave a line out to use the public endpoint. An empty value overrides it, and the targets then fail
SOLANA_DEVNET_RPC=
SOLANA_MAINNET_RPC=

# Keypair file that pays for a deployment and holds the upgrade authority until finalize-* removes it
DEPLOYER_KEYPAIR=

# Keypair file of the program id MzkicG4ev5reLESn2RZvPVufghwgwQhRqvhNqVr8oNb. Needed for the first deployment only
PROGRAM_KEYPAIR=

# sha256 of the reviewed verifiable build, which the Build CI job prints. The deploy and finalize targets refuse any other binary
PROGRAM_BUILD_SHA=

# Git commit of the deployed source, for verify-devnet and verify-mainnet
PROGRAM_BUILD_COMMIT=
